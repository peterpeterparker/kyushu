package kyushu:worker;

/// Custom interface used during `kyu build` to inject resources into the
/// worker's Wasm memory via Wizer pre-initialization.
interface bundle {
  /// The JS bundle executed at runtime (the `fetch` handler)
  get-bundle: func() -> string;

  /// An optional list of static assets (HTML, CSS, images and other files)
  /// to upload as part of the Worker. Useful for implementating a static file
  /// server without IO interactions.
  ///
  /// The asset is a handle allowing data and information to be fetched
  /// on demand.
  resource asset {
    /// The asset's URL path normalized with `/`-prefix
    /// e.g. `/index.html` or `/images/hello.png`
    path: func() -> string;
    /// The mime type of the asset, if known.
    mime-type: func() -> option<string>;
    /// The data of the asset.
    bytes: func() -> list<u8>;
    /// The last modified timestamp of the asset in seconds since Unix epoch.
    last-modified: func() -> option<u64>;
  }

  get-assets: func() -> option<list<asset>>;
}

world worker {
  // Inherit all imports and exports from standard wasi:http proxy
  // @see https://github.com/WebAssembly/WASI
  include wasi:http/proxy@0.2.11;

  // Provides the JS bundle bytes during Wizer pre-initialization
  import bundle;

  // Called by Wizer to pre-initialize the worker with the JS bundle
  export wizer-initialize: func();

  // Called by kyu dev to initialize the JS runtime with the current bundle.
  export kyu-initialize: func();

  // Exposes the worker version, baked in at compile time via CARGO_PKG_VERSION.
  export kyu-version: func() -> string;
}