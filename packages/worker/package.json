{
  "name": "kyushu-worker",
  "version": "0.0.3",
  "description": "Runtime for executing JavaScript fetch handlers inside Kuyshu's worker",
  "bugs": {
    "url": "https://github.com/peterpeterparker/kyushu"
  },
  "license": "MIT",
  "author": "David Dal Busco (https://daviddalbusco.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterpeterparker/kyushu.git",
    "directory": "packages/worker"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "rmdir": "node ../builder/scripts/rmdir.mjs",
    "ts-declaration": "tsc --emitDeclarationOnly --outDir dist/types",
    "build": "pnpm run rmdir && mkdir -p dist && node ../builder/scripts/esbuild.mjs && pnpm run ts-declaration",
    "prepack": "npm run build",
    "test": "tsc --project tsconfig.spec.json --noEmit && vitest"
  },
  "devDependencies": {
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "kyushu-types": "workspace:*"
  }
}
